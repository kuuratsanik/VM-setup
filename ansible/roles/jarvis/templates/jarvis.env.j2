LITELLM_URL=http://127.0.0.1:4000
LITELLM_KEY={{ jarvis_litellm_key }}
JARVIS_SESSION_SECRET={{ jarvis_session_secret }}
JARVIS_STATE_DIR=/var/lib/vmsetup/jarvis
PROMETHEUS_URL=http://127.0.0.1:9090
# RunPod spend guards (hourly cap in USD, maximum pod lifetime in hours)
JARVIS_RUNPOD_MAX_HOURLY_USD={{ (ai | default({})).get('compute', {}).get('runpod_max_hourly_usd', 1.0) }}
JARVIS_RUNPOD_MAX_HOURS={{ (ai | default({})).get('compute', {}).get('runpod_max_hours', 4) }}
# Set to 1 only when Jarvis is served over HTTPS (reverse proxy); marks the session cookie Secure
JARVIS_HTTPS=0
