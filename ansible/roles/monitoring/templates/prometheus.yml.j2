global:
  scrape_interval: {{ monitoring.scrape_interval }}
rule_files: [/etc/prometheus/alerts.yml]
alerting:
  alertmanagers:
    - static_configs: [{ targets: ["127.0.0.1:9093"] }]
scrape_configs:
  - job_name: node
    static_configs: [{ targets: ["127.0.0.1:9100"] }]
  - job_name: libvirt
    static_configs: [{ targets: ["127.0.0.1:9177"] }]
  - job_name: vms
    static_configs:
      - targets: [{% for n in nodes.values() %}"{{ n.ip }}:9100"{% if not loop.last %}, {% endif %}{% endfor %}]
  - job_name: netdata
    metrics_path: /api/v1/allmetrics
    params: { format: [prometheus] }
    honor_labels: true
    static_configs: [{ targets: ["127.0.0.1:19999"] }]
