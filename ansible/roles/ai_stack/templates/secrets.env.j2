LITELLM_MASTER_KEY={{ ai_stack_master_key }}
# Caller key for Jarvis and the agents. LiteLLM only accepts the master key until this key is registered with the gateway
# (virtual keys need a LiteLLM database), so LITELLM_KEY stays the master key for now; switch it to LITELLM_CALLER_KEY then.
LITELLM_KEY={{ ai_stack_master_key }}
LITELLM_CALLER_KEY={{ ai_stack_caller_key }}
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: OpenRouter (Hermes 405B and others) and Hugging Face (gated models for vLLM)
OPENROUTER_API_KEY=
HF_TOKEN=
# Autonomy mode and limits live in agents/autonomy.yaml (a reviewed change), not here.
# Optional: where approval requests and the daily digest are sent (Slack/Discord-style webhook, or ntfy with FORMAT=text)
AUTONOMY_NOTIFY_URL=
AUTONOMY_NOTIFY_FORMAT=json
# Vector memory (agents/memory.py); the password matches /etc/vmsetup/pg.env
VMSETUP_DATABASE_URL=postgresql://vmsetup:{{ ai_stack_pg_password }}@127.0.0.1:5432/vmsetup
# PR-opening agents (capacity, upgrade, librarian, models): a fine-grained token with contents and pull requests write
GH_TOKEN=
VMSETUP_REPO_URL={{ vmsetup_repo_url | default('') }}
# Optional Argo CD MCP server (read-only)
ARGOCD_BASE_URL=
ARGOCD_API_TOKEN=
# Optional Langfuse cloud tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
